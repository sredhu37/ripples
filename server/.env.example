# Copy to server/.env and pass it to the container: docker run --env-file server/.env ...
# The API does not read .env files itself. In dev, no variable is needed (server/config.ts has defaults).

# Required when NODE_ENV=production (the image sets it). Neon needs ?sslmode=require.
# From inside a container, "localhost" is the container itself: use host.docker.internal for a
# Postgres running on your machine.
DATABASE_URL=postgres://ripples:ripples@host.docker.internal:5432/ripples

# Port the API listens on. Default 8080.
PORT=8080

# Optional: folder with the built app. When set, the API serves it at "/". The image leaves it unset.
# DIST_DIR=
