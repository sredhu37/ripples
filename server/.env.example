# Copy this file to server/.env and pass it to the container with docker run --env-file server/.env.
# The API does not load .env files itself. For local development, it uses defaults from server/config.ts.

# Required
# Set your production database URL here. The server image sets NODE_ENV=production.
# For Neon, add ?sslmode=require. If Postgres runs on your machine, use host.docker.internal
# instead of localhost from inside the container.
DATABASE_URL=postgres://ripples:ripples@host.docker.internal:5432/ripples
# Use a unique secret of at least 32 characters in production.
BETTER_AUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters

# If you set RESEND_API_KEY below, set the sender address here too.
# EMAIL_FROM=login@example.com

# Optional
# The server image already sets NODE_ENV=production.
# NODE_ENV=production
# Set PORT only if the API should listen on a different port; it defaults to 8080.
# PORT=8080
# Set this if the public API address differs from the address in incoming requests.
# BETTER_AUTH_URL=
# Set this to email login codes with Resend. Without it, codes appear in the API log.
# RESEND_API_KEY=
# Set these legal details at deploy time, not in git. The address can use semicolons between lines.
# LEGAL_NAME=
# LEGAL_ADDRESS=
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_VAT_ID=
# Set feature toggles as a JSON object, e.g. {"show-loans": false}. These do not control access.
# FEATURES=
# Set this to a built app folder if the API should serve the app at /; otherwise, it serves the API only.
# DIST_DIR=
