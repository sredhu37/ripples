# Copy to server/.env and pass it to the container: docker run --env-file server/.env ...
# The API does not read .env files itself. In dev, no variable is needed (server/config.ts has defaults).

# Required
# Required when NODE_ENV=production (the server image sets it).
# Neon needs ?sslmode=require.
# From inside a container, "localhost" is the container itself: use host.docker.internal for a
# Postgres running on your machine.
DATABASE_URL=postgres://ripples:ripples@host.docker.internal:5432/ripples
# Required in production. Replace with a unique secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters

# Required only when RESEND_API_KEY is set.
# EMAIL_FROM=login@example.com

# Optional
# Environment mode. The server image sets this to production.
# NODE_ENV=production
# API port. Default 8080.
PORT=8080
# Public API address, e.g. https://ripples.example. Defaults to the request address.
# BETTER_AUTH_URL=
# Enables sending login codes with Resend. If unset, codes are written to the API log.
# RESEND_API_KEY=
# Legal details served at /api/legal. Configure at deploy time, never in git.
# Separate address lines with a semicolon.
# LEGAL_NAME=
# LEGAL_ADDRESS=
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_VAT_ID=
# JSON object of feature flags, e.g. {"show-loans": false}. Unset: no flags are enabled.
# FEATURES=
# Optional folder with the built app. When set, the API serves it at "/". Unset: API only.
# DIST_DIR=
