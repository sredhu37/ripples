# Settings for `docker compose up` (compose.yaml). Copy to .env, which git ignores.

# Required
# Signs login cookies. At least 32 characters, for example the output of: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Optional
# Host port of the app. Default 8080.
# RIPPLES_PORT=8080
# Password of the stack's Postgres. Postgres is reachable only inside the stack. Default ripples.
# POSTGRES_PASSWORD=
# Public address of the app when it is not http://localhost:<RIPPLES_PORT>.
# BETTER_AUTH_URL=
# Email login codes with Resend. Without it, codes appear in `docker compose logs server`.
# RESEND_API_KEY=
# EMAIL_FROM=Ripples <login@example.com>
# Feature toggles as a JSON object, e.g. {"show-loans": false}.
# FEATURES=
# Impressum details. Separate address lines with semicolons.
# LEGAL_NAME=
# LEGAL_ADDRESS=
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_VAT_ID=
