# Copy to web/.env and pass it to the container: docker run --env-file web/.env ...
# Read by nginx at container start (web/nginx.conf.template). Vite does not read it:
# in dev, /api goes to http://localhost:8080 (web/vite.config.ts).

# Origin of the backend: scheme, host and port. No trailing slash, no path.
# From inside a container, "localhost" is the container itself. Use the backend's service
# name on a shared Docker network (http://backend:8080), or http://host.docker.internal:8080
# for a backend running on your machine.
BACKEND_URL=http://host.docker.internal:8080
