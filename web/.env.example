# Copy this file to web/.env and pass it to the container with docker run --env-file web/.env.
# Vite does not load it. In development, Vite sends /api requests to http://localhost:8080.

# Required
# Set the backend origin used by nginx. Do not add a trailing slash or path.
# When the web and backend containers share a Docker network, use the backend service name,
# such as http://backend:8080. For a backend running on your machine, use
# http://host.docker.internal:8080.
BACKEND_URL=http://host.docker.internal:8080

# Optional
# The web container has no optional environment variables.
