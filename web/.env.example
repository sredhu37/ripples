# Copy to web/.env and pass it to the container: docker run --env-file web/.env ...
# Vite does not read this file. In development, /api goes to http://localhost:8080
# (web/vite.config.ts).

# Required
# Backend origin used by nginx in the web container. No trailing slash or path.
# From inside a container, "localhost" is the container itself. Use the backend's service
# name on a shared Docker network, or host.docker.internal for a backend running on your machine.
BACKEND_URL=http://host.docker.internal:8080

# Optional
# No optional web runtime variables.
